    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@xyflow/react": "^12.11.2",
