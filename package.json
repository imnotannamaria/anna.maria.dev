    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "lucide-react": "^1.29.0",
    "motion": "^12.38.0",
    "next": "16.2.3",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^5.2.10",
